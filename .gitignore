Assets/Plugins/AmplifyShaderEditor/Plugins/EditorResources/Templates/URP 10x.unitypackage.meta
Assets/Plugins/AmplifyShaderEditor/Plugins/EditorResources/Templates/URP 12x.unitypackage.meta

