# =============================================================================
# ③ 本项目自定义段
# =============================================================================

# ---- ResKit AssetBundle 与 OTA 构建产物（本地生成，不入库）----
# Ab 打包输出、ResKit 的 StreamingAssets 载荷，以及 OTA 静态内容服务器的 content
# 副本（web/LanOtaServer/content/ 由该子目录自带的 .gitignore 忽略）。
/AssetBundles/
/Thrud_Remark_BurstDebugInformation_DoNotShip/
Assets/StreamingAssets/AssetBundles/
Assets/StreamingAssets/AssetBundles.meta

# ProgressChaser 等 web 工具的数据目录（运行时写入的可视化队列数据）
web/data/*

# ---- Unity 截图 / 调试产物（不入库）----
# 真机与编辑器截图会长期累积，不入库
/Screenshots/

# ---- Unity Android 构建临时目录 ----
# .utmp/ 是 Unity 出 Android 包时生成的构建临时目录：包含各 ABI（arm64-v8a 等）的
# CMake/ninja 缓存（CMakeCache.txt、build.ninja、.cmake/api/...）、FramePacing
# （swappy）、hash_key.txt 等。每次出包都会重建，可随时删除，绝不可入库。
.utmp/
